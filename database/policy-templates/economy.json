          "key": "funding_ratio",
          "labels": {
            "en": "Share of feasible development requirement",
            "fr": "Part des besoins de développement réalisable"
          },
          "value_type": "decimal",
          "unit_key": "fraction_of_program_requirement",
          "default_value": "0.00",
          "min_value": "0.00",
          "max_value": "1.00",
          "step": "0.01",
          "sort_order": 0
