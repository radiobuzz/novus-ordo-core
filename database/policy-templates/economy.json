{
  "name": "Production economy — civilian-balanced opening v2",
  "description": "Funded public/private production, earned income, development and food security.",
  "policies": [
    {
      "key": "income_tax",
      "category_key": "economy",
      "labels": {
        "en": "Income tax",
        "fr": "Impôt sur le revenu"
      },
      "descriptions": {
        "en": "Taxes formal civilian income. High rates encourage avoidance and unrest; compliance recovers slowly after reductions.",
        "fr": "Impose les revenus déclarés. Des taux élevés encouragent l’économie informelle et les troubles; la conformité se rétablit lentement après une baisse."
      },
      "sort_order": 1,
      "status": "active",
      "options": [
        {
          "key": "standard",
          "labels": {
            "en": "Standard"
          },
          "descriptions": {},
          "is_default": true,
          "sort_order": 1,
          "retired": false,
          "effects": [
            {
              "key": "tax_rule",
              "effect_type": "finance.income_tax",
              "arguments": {
                "base": "taxable_income",
                "rate": {
                  "parameter": "rate"
                }
              },
              "sort_order": 0
            }
          ]
        }
      ],
      "parameters": [
        {
          "key": "rate",
          "labels": {
            "en": "Tax rate"
          },
          "value_type": "decimal",
          "unit_key": "fraction_of_taxable_income",
          "default_value": "0.25",
          "min_value": "0.00",
          "max_value": "1.00",
          "step": "0.01",
          "sort_order": 0
        }
      ],
      "conditions": []
    },
    {
      "key": "infrastructure_funding",
      "category_key": "infrastructure",
      "labels": {
        "en": "Infrastructure funding",
        "fr": "Financement des infrastructures"
      },
      "descriptions": {
        "en": "Share of assessed maintenance and feasible improvements. Maintenance is paid first. Funding depends on affordable cash and credit; benefits build over subsequent seasons.",
        "fr": "Part des besoins d’entretien et des améliorations réalisables. L’entretien est prioritaire. Le financement dépend des fonds disponibles; les bénéfices apparaissent progressivement."
      },
      "sort_order": 2,
      "status": "active",
      "options": [
        {
          "key": "enabled",
          "labels": {
            "en": "Enabled"
          },
          "descriptions": {},
          "is_default": true,
          "sort_order": 2,
          "retired": false,
          "effects": [
            {
              "key": "program_allocation",
              "effect_type": "budget.program_funding",
              "arguments": {
                "program": "infrastructure",
                "funding_ratio": {
                  "parameter": "funding_ratio"
                }
              },
              "sort_order": 0
            }
          ]
        }
      ],
      "parameters": [
        {
          "key": "funding_ratio",
          "labels": {
            "en": "Share of calculated funding requirement"
          },
          "value_type": "decimal",
          "unit_key": "fraction_of_program_requirement",
          "default_value": "1.00",
          "min_value": "0.00",
          "max_value": "1.00",
          "step": "0.01",
          "sort_order": 0
        }
      ],
      "conditions": []
    },
