    {
      "key": "agricultural_funding",
      "category_key": "agriculture",
      "labels": {
        "en": "Agricultural development funding",
        "fr": "Financement du développement agricole"
      },
      "descriptions": {
        "en": "Funds gradual expansion of developed agricultural capacity. Existing farms continue producing without this program. The budget scales with buildable potential, even when food needs are already met. Paid after infrastructure; improvements produce from the following season.",
        "fr": "Finance progressivement la capacité agricole. Les exploitations existantes continuent sans ce programme. Le budget dépend du potentiel aménageable, même lorsque les besoins alimentaires sont déjà couverts. Payé après les infrastructures; les améliorations produisent à partir de la saison suivante."
      },
      "sort_order": 4,
      "status": "active",
      "options": [
        {
          "key": "enabled",
          "labels": {
            "en": "Enabled",
            "fr": "Activé"
          },
          "descriptions": {},
          "is_default": true,
          "sort_order": 0,
          "retired": false,
          "effects": [
            {
