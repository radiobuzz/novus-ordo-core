+    /** Spend new household funds on still-unmet essentials without restarting production. */
+    private static function settleRemainingConsumption(ProductionAccounts $a, array &$rows, array $defs): void
+    {
+        foreach ($rows as $key => &$row) {
+            $remaining = $row['civilian']['unmet'];
+            if (Q::cmp($remaining, '0') <= 0) continue;
+            $cashBefore = $a->availableCash('household');
+            $private = $a->purchase('household', 'producer', $key, $remaining);
+            $publicLeft = self::positive(Q::sub($row['production']['government'], self::sum([$row['public_industry_delivery'], $row['public_delivery'], $row['civilian']['public_purchase'], $row['civilian']['released']])));
+            $public = $a->purchase('household', 'government', $key, Q::min($publicLeft, self::positive(Q::sub($remaining, $private))));
+            $d = $a->consumeDemand('household', $key, $remaining, [], 'government', '0');
+            $row['civilian']['fulfilled'] = Q::add($row['civilian']['fulfilled'], $d['fulfilled']);
+            $row['civilian']['unmet'] = $d['unmet'];
+            $row['civilian']['private_purchase'] = Q::add($row['civilian']['private_purchase'], $private);
+            $row['civilian']['public_purchase'] = Q::add($row['civilian']['public_purchase'], $public);
+            $row['civilian']['unaffordable'] = Q::min($d['unmet'], self::positive(Q::sub($remaining, self::div($cashBefore, $defs[$key]['price']))));
+            $row['civilian']['unavailable'] = Q::sub($d['unmet'], $row['civilian']['unaffordable']);
+            $row['civilian']['shortage_reason'] = Q::cmp($d['unmet'], '0') > 0 ? (Q::cmp(Q::add($a->availableStock('producer', $key), $a->availableStock('government', $key)), '0') > 0 ? 'purchasing_power' : 'supply') : null;
+        } unset($row);
+    }
